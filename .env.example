# Copie para .env e ajuste:   cp .env.example .env
# O arquivo .env NÃO vai para o repositório (.gitignore).

# Banco PostgreSQL (docker compose)
POSTGRES_USER=opinion
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=opinion

# Segredo dos IDs anônimos e rotativos da pulseira (HMAC).
# ATENÇÃO: o dataset simulado em data/bootstrap foi gerado com o valor de DESENVOLVIMENTO abaixo.
# Com outro valor, a ingestão não reconhece os IDs desses dados. Em produção, gere um novo
# (ex.: python -c "import secrets; print(secrets.token_hex(32))") e gere os dados de novo.
OPINION_SEGREDO_TOKEN=segredo-de-desenvolvimento-troque-em-producao

# Linux: id do seu usuário, para o Airflow poder escrever em ./data  (rode: id -u)
AIRFLOW_UID=50000

# Opcional: usar PostgreSQL fora do Docker em vez do SQLite local
# DATABASE_URL=postgresql://opinion:troque-esta-senha@localhost:5432/opinion
